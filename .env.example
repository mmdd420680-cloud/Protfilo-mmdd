# ============================================================================
# MAHIM DEV — FULL-STACK DEVELOPER PORTFOLIO & CMS ENVIRONMENT CONFIGURATION
# Copy this file to .env and provide your production values. Never commit .env.
# ============================================================================

# Application Runtime
NODE_ENV=development
PORT=3000
CLIENT_URL=http://localhost:3000
APP_URL=http://localhost:3000

# MongoDB Database (Atlas or Self-Hosted)
# Leave empty in local development to automatically boot an embedded MongoDB instance
# with initial seed data. Required in production (NODE_ENV=production).
MONGODB_URI=

# Authentication & Security
JWT_SECRET=change_this_to_a_cryptographically_random_64_char_secret_key
JWT_EXPIRES_IN=7d
COOKIE_SECRET=change_this_to_a_secure_cookie_signing_secret_key

# Initial Admin Bootstrap (Used by `npm run seed` or `npm run create-admin`)
INITIAL_ADMIN_NAME="Mahim Dev"
INITIAL_ADMIN_EMAIL=admin@mahimdev.com
INITIAL_ADMIN_PASSWORD=

# Cloud Media Storage (Optional — falls back to local /uploads storage in development)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Outbound SMTP Email Integration (Optional — required for direct inbox email replies)
EMAIL_SERVICE_HOST=
EMAIL_SERVICE_PORT=587
EMAIL_SERVICE_USER=
EMAIL_SERVICE_PASSWORD=
EMAIL_FROM_ADDRESS=hello@mahimdev.com

# Platform Integration
GEMINI_API_KEY=
